---
import type { RecipeData } from '@/types/index'
import { getRecipeTotalTime } from '@/lib/recipes';
import { formatDuration } from '@/utils/formatDuration';

interface Props {
  recipe: RecipeData
}

const { recipe } = Astro.props
const totalTime = getRecipeTotalTime(recipe)
---

<a href={`/recipes/${recipe.slug}/`} class="recipe-card">
    <div>
        <div class="recipe-card__header">
            <h3 class="recipe-card__title">{recipe.title}</h3>
            <dl class="recipe-card__meta">
              <div>
                <dt class="meta-term">Time</dt>
                <dd>{formatDuration(totalTime)}</dd>
              </div>
            </dl>
        </div>
        {recipe.description && <p class="recipe-card__description">{recipe.description}</p>}
    </div>
</a>

<style lang="scss">
.recipe-card {
  display: flex;
  flex-direction: column;
  background: var(--surface-raised);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem;
  text-decoration: none;
  color: inherit;
  transition: all 0.2s ease;
  box-shadow: var(--shadow);

  &:hover, &:active, &:focus {
    background: var(--surface);
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
}

.recipe-card__header {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.recipe-card__title {
  font-size: 1.125rem;
  font-weight: 600;
  margin: 0;
  color: var(--text);
}

.recipe-card__meta {
  display: flex;
  gap: 1rem;
  font-size: 0.875rem;
  margin: 0;

  > div {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  dd {
    margin: 0;
    font-size: 0.875rem;
  }
}

.meta-term {
  display: inline-flex;
  align-items: center;
  color: var(--text-secondary);
  margin: 0;
  text-transform: uppercase;
  font-size: .8rem;
  font-weight: 600;
}

.meta-term + dd {
  margin: 0;
  color: var(--text);
}

.recipe-card__description {
  margin: 0;
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.4;
}
</style>