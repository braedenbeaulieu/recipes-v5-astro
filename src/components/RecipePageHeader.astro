---
import type { RecipeData } from '@/types/index'
import RecipeMeta from '@/components/RecipeMeta.astro'
import { formatTaxName } from '@/utils/formatTaxName'
import { slugify } from '@/utils/slugify'

interface Props {
  recipePage: RecipeData
  categorySlug: string
}

const { recipePage, categorySlug } = Astro.props

const decodeHtmlEntities = (value: string) =>
  value
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&#(\d+);/g, (_, code) => String.fromCharCode(Number(code)))
    .replace(/&#x([0-9a-fA-F]+);/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
---

<header class="page-header page-header--recipe">
  <p class="page-header__eyebrow">
    <a href={`/categories/${categorySlug}/`}>{formatTaxName(categorySlug)}</a>
  </p>
  <h1>{recipePage.title}</h1>
  {recipePage.description && <p>{decodeHtmlEntities(recipePage.description)}</p>}
  {recipePage.tags?.length && (
    <p class="recipe-tags">
      <span class="screen-reader-text">Tags</span>
      {recipePage.tags.map((tag: string) => (
        <a class="tag" href={`/tags/${slugify(tag)}/`}>
          {tag}
        </a>
      ))}
    </p>
  )}

  <RecipeMeta
    prepTime={recipePage.prepTime}
    cookTime={recipePage.cookTime}
    totalTime={recipePage.totalTime}
    servings={recipePage.servings}
    difficulty={recipePage.difficulty}
  />

  <div class="recipe-actions">
    <slot name="actions" />
  </div>
</header>

<style lang="scss">
  .page-header {
    margin-bottom: 2rem;

    h1 {
      margin-top: 0;
      margin: 0.35rem 0 0.5rem;
      font-size: clamp(2rem, 4vw, 3rem);
    }
    p {
      max-width: 62ch;
      color: var(--muted);
      line-height: 1.6;
    }
  }

  .page-header__eyebrow {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--text);
    margin-top: 0;
  }

  .recipe-tags {
    margin: 0.85rem 0;
  }

  .tag {
    display: inline-flex;
    margin: 0.2rem 0.3rem 0.2rem 0;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-subtle);
    border: 1px solid var(--surface-subtle-border);
    color: var(--text);
    font-size: 0.85rem;
  }

  .recipe-actions > * {
    display: grid;
    align-items: center;
    justify-content: center;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .recipe-actions > :global(*) {
    width: 100%;
  }
</style>
