---
import { formatDuration } from '@/utils/formatDuration'

interface Props {
  prepTime?: string
  cookTime?: string
  totalTime?: string
  servings?: string | number
  difficulty?: string
}

const { prepTime, cookTime, totalTime, servings, difficulty } = Astro.props
---

<dl class="recipe-meta">
  {prepTime && (
    <div class="recipe-meta__item">
      <dt>Prep</dt>
      <dd>{formatDuration(prepTime)}</dd>
    </div>
  )}
  {cookTime && (
    <div class="recipe-meta__item">
      <dt>Cook</dt>
      <dd>{formatDuration(cookTime)}</dd>
    </div>
  )}
  {totalTime && (
    <div class="recipe-meta__item">
      <dt>Total</dt>
      <dd>{formatDuration(totalTime)}</dd>
    </div>
  )}
  {servings && (
    <div class="recipe-meta__item">
      <dt>Servings</dt>
      <dd>{servings}</dd>
    </div>
  )}
  {difficulty && (
    <div class="recipe-meta__item">
      <dt>Difficulty</dt>
      <dd>{difficulty}</dd>
    </div>
  )}
</dl>

<style>
  .recipe-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }

  .recipe-meta__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--panel-soft);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 0.45rem 0.8rem;
  }

  .recipe-meta__item dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .recipe-meta__item dd {
    margin: 0;
    font-weight: 600;
    color: var(--text);
  }
</style>
