---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import AppSidebar from '@/components/AppSidebar.vue';
import RecipeGrid from '@/components/RecipeGrid.astro';
import { getRecipeItems, getRecipesByTag, getAllTags } from '@/lib/recipes';
import { formatTaxName } from '@/utils/formatTaxName';
import type { RecipeData } from '@/types/index';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.params;

if (!tag) {
  return new Response('Not found', { status: 404 });
}

const recipesWithTag = await getRecipesByTag(tag);
const recipeItems: RecipeData[] = await getRecipeItems()
---

<BaseLayout 
  title={`${tag} Recipes`} 
  description={`Browse recipes tagged with ${tag}.`}
>
  <AppShell>
    <fragment slot="sidebar">
      <AppSidebar client:load items={recipeItems} />
    </fragment>

    <main class="content-area">
      <header class="page-header">
        <h1>Tag: {formatTaxName(tag)}</h1>
        <p>{recipesWithTag.length} recipe{recipesWithTag.length > 1 ? 's' : ''}</p>
      </header>

      <RecipeGrid recipes={recipesWithTag} />
    </main>
  </AppShell>
</BaseLayout>