---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import AppSidebar from '@/components/AppSidebar.vue';
import AppToc from '@/components/AppToc.astro';
import RecipePageHeader from '@/components/RecipePageHeader.astro';
import KeepAwakeToggle from '@/components/KeepAwakeToggle.vue';
import GroceryListButton from '@/components/GroceryListButton.vue';
import RecipeContentEnhancer from '@/components/RecipeContentEnhancer.vue';
import { getRecipeEntryBySlug, getRecipeNavigation, getRecipeItems, getRecipeTotalTime } from '@/lib/recipes';
import type { RecipeData } from '@/types/index';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  const paths = [];
  
  for (const recipe of recipes) {
    paths.push({
      params: { slug: recipe.id },
      props: { slug: recipe.id }
    });
  }
  
  return paths;
}

const { slug } = Astro.params;

if (!slug) {
  return new Response('Not found', { status: 404 });
}

const recipe = await getRecipeEntryBySlug(slug);

if (!recipe) {
  return new Response('Not found', { status: 404 });
}

const { Content, headings } = await render(recipe);

const recipeItems: RecipeData[] = await getRecipeItems()

// Build TOC from headings
const toc = headings.map((heading: any) => ({
  depth: heading.depth,
  text: heading.text,
  id: heading.slug
}));

const currentPath = `/recipes/${slug}/`;

const categorySlug = recipe.data.category || 'uncategorized';

const totalTime = getRecipeTotalTime(recipe.data)
recipe.data.totalTime = totalTime

const nav = await getRecipeNavigation(slug);
---

<BaseLayout 
  title={recipe.data.title}
  description={recipe.data.description || `Recipe for ${recipe.data.title}`}
>
  <AppShell hasToc={true}>
    <fragment slot="sidebar">
      <AppSidebar client:load items={recipeItems} currentPath={currentPath} />
    </fragment>

    <article class="recipe-page">
      <RecipePageHeader 
        recipePage={recipe.data}
        categorySlug={categorySlug}
      >
        <div slot="actions" class="recipe-actions-container">
          <KeepAwakeToggle client:load />
          <GroceryListButton client:load />
        </div>
      </RecipePageHeader>

      <div class="recipe-content">
        <Content />
      </div>
    </article>

    <div slot="toc">
      <AppToc links={toc} />
    </div>
  </AppShell>

  <RecipeContentEnhancer client:load slug={slug} />
</BaseLayout>

<style lang="scss">
  .recipe-page {
    max-width: 860px;
  }

  :global(main.content-area) {
    padding: 1.5rem clamp(0.75rem, 2.5vw, 2rem) 3rem;
  }

  @media (max-width: 1180px) {
    .recipe-page {
      max-width: none;
    }
  }

  @media (max-width: 860px) {
    :global(main.content-area) {
      padding: 1.25rem 1rem 2.5rem;
    }
  }

  .recipe-actions-container {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 20px;
  }
</style>
