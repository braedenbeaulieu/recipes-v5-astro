---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import AppSidebar from '@/components/AppSidebar.vue';
import { formatCategory } from '@/utils/formatCategory';
import { getAllRecipes, getRecipesByCategory } from '@/lib/recipes';
import type { RecipeWithSlug } from '@/types/index';

const recipes = await getAllRecipes();
const grouped = await getRecipesByCategory();

interface RecipeItem {
  title: string;
  path: string;
  slug: string;
  category: string;
  description?: string;
  prepTime?: string;
  totalTime?: string;
  servings?: string | number;
  difficulty?: string;
}

const recipeItems: RecipeItem[] = recipes.map((recipe: RecipeWithSlug) => {
  return {
    title: recipe.data.title,
    path: `/recipes/${recipe.slug}/`,
    slug: recipe.slug,
    category: recipe.data.category || 'uncategorized',
    description: recipe.data.description,
    prepTime: recipe.data.prepTime,
    totalTime: recipe.data.totalTime,
    servings: recipe.data.servings,
    difficulty: recipe.data.difficulty
  };
});

const categories = Object.entries(grouped).map(([slug, recipesInCat]) => ({
  slug,
  name: formatCategory(slug),
  count: recipesInCat.length
}));
---

<BaseLayout title="Categories" description="Browse recipes by category.">
  <AppShell>
    <fragment slot="sidebar">
      <AppSidebar client:load items={recipeItems} />
    </fragment>

    <main class="content-area">
      <header class="page-header">
        <h1>Categories</h1>
        <p>Browse recipes by category.</p>
      </header>

      <div class="categories-grid">
        {
          categories.map((category) => (
            <a href={`/categories/${category.slug}/`} class="category-card">
              <h2>{category.name}</h2>
              <p class="recipe-count">{category.count} recipes</p>
            </a>
          ))
        }
      </div>
    </main>
  </AppShell>
</BaseLayout>

<style>
  .page-header {
    padding: 0;
  }

  .page-header h1 {
    margin-top: 0;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--text-secondary);
    margin: 0;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
    padding: 2rem clamp(0.75rem, 2.5vw, 2rem);
  }

  .category-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: var(--surface-raised);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    min-height: 200px;
    box-shadow: var(--shadow);
  }

  .category-card:hover {
    background: var(--surface);
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .category-card h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.5rem;
  }

  .recipe-count {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
</style>
