---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import AppSidebar from '@/components/AppSidebar.vue';
import TaxList from '@/components/TaxList.astro';
import { formatTaxName } from '@/utils/formatTaxName';
import { getAllRecipes, getRecipesByCategory } from '@/lib/recipes';
import type { RecipeWithSlug } from '@/types/index';

const recipes = await getAllRecipes();
const grouped = await getRecipesByCategory();

interface RecipeItem {
  title: string;
  path: string;
  slug: string;
  category: string;
  description?: string;
  prepTime?: string;
  totalTime?: string;
  servings?: string | number;
  difficulty?: string;
}

const recipeItems: RecipeItem[] = recipes.map((recipe: RecipeWithSlug) => {
  return {
    title: recipe.data.title,
    path: `/recipes/${recipe.slug}/`,
    slug: recipe.slug,
    category: recipe.data.category || 'uncategorized',
    description: recipe.data.description,
    prepTime: recipe.data.prepTime,
    totalTime: recipe.data.totalTime,
    servings: recipe.data.servings,
    difficulty: recipe.data.difficulty
  };
});

const categories = Object.entries(grouped).map(([slug, recipesInCat]) => ({
  slug,
  name: formatTaxName(slug),
  count: recipesInCat.length
}));
---

<BaseLayout title="Categories" description="Browse recipes by category.">
  <AppShell>
    <fragment slot="sidebar">
      <AppSidebar client:load items={recipeItems} />
    </fragment>

    <main class="content-area">
      <header class="page-header">
        <h1>Categories</h1>
        <p>Browse recipes by category.</p>
      </header>

      <TaxList slug="categories" terms={categories} />
    </main>
  </AppShell>
</BaseLayout>
