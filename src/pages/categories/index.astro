---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import AppSidebar from '@/components/AppSidebar.vue';
import TaxList from '@/components/TaxList.astro';
import { getAllRecipeEntries, getRecipeItems, getAllCategories } from '@/lib/recipes';
import type { RecipeData } from '@/types/index';

const recipes = await getAllRecipeEntries();
const recipeItems: RecipeData[] = await getRecipeItems()
const categories = await getAllCategories();
const categoryCounts: Record<string, number> = {};
recipes.forEach((recipe) => {
  if (recipe.data.category) {
    categoryCounts[recipe.data.category] = (categoryCounts[recipe.data.category] || 0) + 1;
  }
});

const categorysList = categories.map((category) => ({
  name: category,
  count: categoryCounts[category] || 0
}));
---

<BaseLayout title="Categories" description="Browse recipes by category.">
  <AppShell>
    <fragment slot="sidebar">
      <AppSidebar client:load items={recipeItems} />
    </fragment>

    <main class="content-area">
      <header class="page-header">
        <h1>Categories</h1>
        <p>Browse recipes by category.</p>
      </header>

      <TaxList slug="categories" terms={categorysList} />
    </main>
  </AppShell>
</BaseLayout>
