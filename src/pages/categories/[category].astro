---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import AppSidebar from '@/components/AppSidebar.vue';
import RecipeGrid from '@/components/RecipeGrid.astro';
import { formatTaxName } from '@/utils/formatTaxName';
import { getRecipeItems, getRecipesInCategory, getAllCategories } from '@/lib/recipes';
import type { RecipeData } from '@/types/index';

export async function getStaticPaths() {
  const categories = await getAllCategories();
  return categories.map((category) => ({
    params: { category },
    props: { category }
  }));
}

const { category } = Astro.params;

if (!category) {
  return new Response('Not found', { status: 404 });
}

const recipesInCategory = await getRecipesInCategory(category);
const recipeItems: RecipeData[] = await getRecipeItems()

---

<BaseLayout 
  title={`${formatTaxName(category)} Recipes`} 
  description={`Browse ${formatTaxName(category)} recipes.`}
>
  <AppShell>
    <fragment slot="sidebar">
      <AppSidebar client:load items={recipeItems} />
    </fragment>

    <main class="content-area">
      <header class="page-header">
        <h1>Category: {formatTaxName(category)}</h1>
        <p>{recipesInCategory.length} recipe{recipesInCategory.length > 1 ? 's' : ''}</p>
      </header>

      <RecipeGrid recipes={recipesInCategory} />
    </main>
  </AppShell>
</BaseLayout>