---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import AppSidebar from '@/components/AppSidebar.vue';
import RecipeGrid from '@/components/RecipeGrid.astro';
import { formatTaxName } from '@/utils/formatTaxName';
import { getAllRecipes, getRecipesByCategory } from '@/lib/recipes';
import type { RecipeWithSlug } from '@/types/index';

// Get all recipes and group by category
const recipes = await getAllRecipes();
const grouped = await getRecipesByCategory();

interface RecipeItem {
  title: string;
  path: string;
  slug: string;
  category: string;
  description?: string;
  prepTime?: string;
  cookTime?: string;
  servings?: string | number;
  difficulty?: string;
}

const recipeItems: RecipeItem[] = recipes.map((recipe: RecipeWithSlug) => {
  return {
    title: recipe.data.title,
    path: `/recipes/${recipe.slug}/`,
    slug: recipe.slug,
    category: recipe.data.category || 'uncategorized',
    description: recipe.data.description,
    prepTime: recipe.data.prepTime,
    cookTime: recipe.data.cookTime,
    servings: recipe.data.servings,
    difficulty: recipe.data.difficulty
  };
});

const groupedRecipes: Record<string, RecipeItem[]> = {};
recipeItems.forEach((item) => {
  if (!groupedRecipes[item.category]) {
    groupedRecipes[item.category] = [];
  }
  groupedRecipes[item.category].push(item);
});
---

<BaseLayout title="All recipes" description="Browse recipes grouped by category.">
  <AppShell>
    <fragment slot="sidebar">
      <AppSidebar client:load items={recipeItems} />
    </fragment>

    <main class="content-area">
      <header class="page-header">
        <h1>All Recipes</h1>
        <p>Pick a recipe from the sidebar or browse by category below.</p>
      </header>

      {
        Object.entries(groupedRecipes).map(([category, group]) => (
          <section class="recipe-section">
            <h2>
              <a href={`/categories/${category}/`}>{formatTaxName(category)}</a>
            </h2>
            <RecipeGrid recipes={group} />
          </section>
        ))
      }
    </main>
  </AppShell>
</BaseLayout>

<style lang="scss">

.recipe-section {
  margin-bottom: 3rem;
}

.recipe-section h2 {
  font-size: 1.5rem;
  margin-bottom: 1.5rem;
  border-bottom: 2px solid var(--border);
  padding-bottom: 0.5rem;
}

.recipe-section a {
  color: inherit;
  text-decoration: none;
}
</style>